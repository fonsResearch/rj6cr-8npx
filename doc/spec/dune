; isa.md is generated from spec/isa.ml. `dune test` fails if it is out of date;
; `dune promote` updates it.
(rule
 (with-stdout-to
  isa.md.gen
  (run %{exe:../../spec/gen_isa_doc.exe})))

(rule
 (alias runtest)
 (action
  (diff isa.md isa.md.gen)))

; fig/timing_contract.csv is the model's per-cycle record behind fig/timing_contract.png
; (drawn by tools/plot_timing_contract.py). `dune test` fails if it is out of date.
(rule
 (with-stdout-to
  timing_contract.csv.gen
  (run %{exe:../../spec/contract_trace.exe})))

(rule
 (alias runtest)
 (action
  (diff fig/timing_contract.csv timing_contract.csv.gen)))
